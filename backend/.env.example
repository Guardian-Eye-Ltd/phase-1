# GuardianEye - Core Platform Environment Variables

PROJECT_NAME="GuardianEye"
API_V1_STR="/api/v1"

# Security (JWT) Config
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="super-secret-developer-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Config
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="guardianeye"
POSTGRES_PORT=5432

# Async SQLAlchemy Database URL
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/guardianeye"

# CORS Origins (JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
